---
import Tag from "./Tag.astro";
import Icon from "./Icon.astro";

interface Props {
    title: string;
    href: string;
    description?: string;
    date?: string;
    authors?: string;
    extraInput?: string;
    tags?: string[];
    paperUrl?: string;
    gitUrl?: string;
    image?: string;
    award?: string;
}

const { title, href, description, date, authors, extraInput, tags, paperUrl, gitUrl, image, award, } = Astro.props;

const imageSrc = image
  ? image.startsWith("/") || /^https?:\/\//.test(image)
    ? image
    : `/${image}`
  : undefined;
---

<article class="card">
  {
    imageSrc && (
      <a href={href} class="card-image-link">
        <img
          src={imageSrc}
          alt={`${title} thumbnail`}
          class="card-image"
          width="180"
          height="113"
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  
    <div class="card-content">
        {
            award && (
            <div class="award-badge">
                <span aria-hidden="true">★</span>
                <span>{award}</span>
            </div>
            )
        }

        <a href={href} class="card-title">{title}</a>

        <div class="card-meta">
            {date && (
                <span class="flex items-center gap-1">
                    <Icon name="Calendar" size={24} />
                    <span>{date}</span>
                </span>
            )}
            {authors && (
                <span class="flex items-center gap-1">
                    <Icon name="User" size={24} />
                    <span>{authors}</span>
                </span>
            )}
            {extraInput && (
                <span class="flex items-center gap-1">
                    <Icon name="Institution" size={24} />
                    <span>{extraInput}</span>
                </span>
            )}
        </div>

        {
            tags && tags.length > 0 && (
                <div class="flex gap-2 flex-wrap mb-3">
                    {tags.map((tag) => (
                        <Tag name={tag} size="sm" />
                    ))}
                </div>
            )
        }

        {description && <p class="card-desc">{description}</p>}
    </div>

    {
        paperUrl && (
            <div class="flex-shrink-0">
                <a href={paperUrl} target="_blank" rel="noopener noreferrer" class="card-link">
                    Paper
                </a>
            </div>
        )
    }

    {
        gitUrl && (
            <div class="flex-shrink-0">
                <a href={gitUrl} target="_blank" rel="noopener noreferrer" class="card-link">
                    Git
                </a>
            </div>
        )
    }
</article>